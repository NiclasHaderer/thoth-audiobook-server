# Symbols exposed to Kotlin. Read-only surface only: no taglib_*_set*, no save.
# Consumed by ./gradlew :taglib:jextract, which regenerates src/main/java.
--target-package
io.thoth.taglib.ffi
--header-class-name
TagLibC
--include-function
taglib_file_new
--include-function
taglib_file_free
--include-function
taglib_file_is_valid
--include-function
taglib_file_audioproperties
--include-function
taglib_audioproperties_length
--include-function
taglib_audioproperties_bitrate
--include-function
taglib_audioproperties_samplerate
--include-function
taglib_audioproperties_channels
--include-function
taglib_property_keys
--include-function
taglib_property_get
--include-function
taglib_property_free
--include-function
taglib_file_pictures
--include-function
taglib_pictures_free
--include-function
taglib_file_chapters
--include-function
taglib_chapters_free
--include-function
taglib_set_strings_unicode
--include-struct
TagLib_File
--include-struct
TagLib_AudioProperties
--include-struct
TagLib_Chapter
--include-struct
TagLib_Complex_Property_Picture_Data
